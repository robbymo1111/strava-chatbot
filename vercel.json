{
  "rewrites": [
    { "source": "/callback", "destination": "/callback.html" }
  ],
  "functions": {
    "api/brain.js":        { "maxDuration": 60 },
    "api/chat.js":         { "maxDuration": 60 },
    "api/memory.js":       { "maxDuration": 30 },
    "api/oura.js":         { "maxDuration": 30 },
    "api/history-sync.js": { "maxDuration": 60 },
    "api/webhook.js":      { "maxDuration": 60 },
    "api/auth.js":         { "maxDuration": 30 },
    "api/voice.js":        { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/brain?action=cron-intervals",
      "schedule": "0 8 * * *"
    }
  ]
}
